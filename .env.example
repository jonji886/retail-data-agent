# Primary LLM: DeepSeek（模型只负责理解与表达，执行链路仍由本地治理）
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Optional fallback. DeepSeek fails after LLM_MAX_RETRIES 后才尝试 OpenRouter。
LLM_FALLBACK_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODELS=
# Public Demo 可以使用动态免费路由；Real Evaluation 必须填写固定模型
EVAL_LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
OPENROUTER_MAX_TOKENS=1200
LLM_MAX_RETRIES=1
LLM_FALLBACK_MODEL=deterministic
# Optional OpenRouter ranking headers
OPENROUTER_HTTP_REFERER=https://retail-data-agent.onrender.com
OPENROUTER_APP_TITLE=Retail Data Agent

# Data source: duckdb（本地/CI）或 postgresql（Supabase/生产近似环境）
DATA_SOURCE=duckdb
DUCKDB_PATH=data/retail.duckdb
DATABASE_URL=
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT=10000
DB_MAX_RESULT_ROWS=1000
DB_MEMORY_LIMIT=512MB
DB_THREADS=2

# Public Demo quota（Evaluation / 直接 run_agent 不受此限制）
DEMO_RATE_LIMIT_ENABLED=true
DEMO_SESSION_LIMIT=10
DEMO_IP_DAILY_LIMIT=20
DEMO_GLOBAL_DAILY_LIMIT=40
