# LLM Provider: deepseek, qwen, or siliconflow. Credentials are provider-scoped.
LLM_PROVIDER=deepseek
LLM_MODEL=
LLM_MAIN_MODEL=
LLM_ROUTER_MODEL=
LLM_REASONING_MODEL=
LLM_VISION_MODEL=
EVAL_LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1200
LLM_MAX_RETRIES=1
LLM_FALLBACK_MODEL=deterministic

# DeepSeek API (OpenAI-compatible)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MAIN_MODEL=deepseek-flash
DEEPSEEK_ROUTER_MODEL=
DEEPSEEK_REASONING_MODEL=

# Qwen / Alibaba Cloud Model Studio (Beijing endpoint; switch LLM_PROVIDER=qwen)
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_MAIN_MODEL=qwen3.8-flash
QWEN_ROUTER_MODEL=
QWEN_REASONING_MODEL=

# Legacy OpenAI-compatible SiliconFlow setup remains supported.
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
SILICONFLOW_MAIN_MODEL=

# Data source: duckdb (local/CI) or postgresql (Supabase/production-like environment)
DATA_SOURCE=duckdb
DUCKDB_PATH=data/retail.duckdb
DATABASE_URL=
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT=10000
DB_MAX_RESULT_ROWS=1000
DB_MEMORY_LIMIT=512MB
DB_THREADS=2

# Public Demo quota (Evaluation / direct run_agent calls are not limited)
DEMO_RATE_LIMIT_ENABLED=true
DEMO_SESSION_LIMIT=10
DEMO_IP_DAILY_LIMIT=20
DEMO_GLOBAL_DAILY_LIMIT=40
