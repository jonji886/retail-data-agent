# SiliconFlow 网关：模型只负责理解与表达，执行链路仍由本地治理
# Router 仅做低成本意图提示，Main 为主力，Reason 仅在 Main 失败时备用，Vision 预留给多模态入口
LLM_PROVIDER=siliconflow
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=your_api_key_here
ROUTER=<low-cost-router-model>
MAIN=deepseek-ai/DeepSeek-V4-Flash
REASON=Pro/zai-org/GLM-5.1
VISION=<siliconflow-vision-model>
# Real Evaluation 可用 EVAL_LLM_MODEL 固定首个评测模型
EVAL_LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1200
LLM_MAX_RETRIES=1
LLM_FALLBACK_MODEL=deterministic

# Data source: duckdb（本地/CI）或 postgresql（Supabase/生产近似环境）
DATA_SOURCE=duckdb
DUCKDB_PATH=data/retail.duckdb
DATABASE_URL=
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT=10000
DB_MAX_RESULT_ROWS=1000
DB_MEMORY_LIMIT=512MB
DB_THREADS=2

# Public Demo quota（Evaluation / 直接 run_agent 不受此限制）
DEMO_RATE_LIMIT_ENABLED=true
DEMO_SESSION_LIMIT=10
DEMO_IP_DAILY_LIMIT=20
DEMO_GLOBAL_DAILY_LIMIT=40
